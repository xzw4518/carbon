# 生产环境变量模板（云托管 / 容器平台通用）
# 用法：复制为 .env.production 后填写；docker compose 自动读取同目录 .env.production 需显式 --env-file。
# 密钥生成：bash deploy/gen-secret.sh .env.production （JWT_SECRET ≥32 位，缺失则启动失败）

# ---- 端口 ----
# 云平台（Railway / Render / Fly / Cloud Run）自动注入 PORT；本机/Docker 默认 8088
PORT=8088

# ---- 数据源（MySQL 8.0.28+，库与表 utf8mb4）----
DB_URL=jdbc:mysql://<host>:3306/carbonbal?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=carbonbal
DB_PASSWORD=<MySQL 强密码>

# ---- 安全 ----
JWT_SECRET=<openssl rand -hex 32 生成>
JWT_TTL_HOURS=8
# HTTPS 部署必须为 true，否则浏览器不保存登录 Cookie
AUTH_COOKIE_SECURE=true
AUTH_CAPTCHA=true
AUTH_CAPTCHA_LOGIN=true
AUTH_PWD_MIN=12
# 反向代理（nginx / 云负载均衡）的内网地址，逗号分隔；留空表示不信任任何代理
TRUSTED_PROXIES=
# 生产填实际域名，留空表示不开放跨域
CORS_ALLOWED_ORIGINS=

# ---- 运行开关 ----
SEED_ENABLED=true          # 首次启动灌演示数据；演示结束改 false
JOBS_ENABLED=true          # 预警扫描 / 月报 / 配额提醒
REPORT_MACHINE_LINE=false  # 生产关闭 [MACHINE] 机器摘要行
SMS_FIXED_CODE=            # 生产留空
SMS_EXPOSE_CODE=false      # 生产必须 false
LOG_FILE=/app/logs/carbonbal.log

# ---- 上传文件持久化 ----
# 应用写入 ./data/files；容器部署需挂载持久卷到该路径，否则重启丢附件
APP_FILE_ROOT=./data/files
